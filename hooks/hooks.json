{
  "description": "Warns at session start if eyesoff isn't actually filtering this session's requests.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
